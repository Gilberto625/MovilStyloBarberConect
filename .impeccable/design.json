  "components": [
    {
      "name": "Botón principal",
      "kind": "button",
      "refersTo": "boton-principal",
      "description": "La acción principal de la pantalla (Reservar, Confirmar, Cobrar). Una por pantalla.",
      "html": "<button class=\"ds-btn-principal\">Reservar cita</button>",
      "css": ":host{--laton:#D4AF37;--laton-hondo:#B8941F;--tinta:#0A120E;--cuero:#14211B;--cuero-claro:#1B2A23;--marfil:#F4F0E8;--niebla:#A6BAB0;--filo:#3D4F49;--ease:cubic-bezier(0.23,1,0.32,1);}.ds-btn-principal{background:#D4AF37;color:#0A120E;height:52px;padding:0 20px;border:none;border-radius:14px;font:700 15px Manrope,sans-serif;transition:transform 120ms cubic-bezier(0.23,1,0.32,1),background 120ms cubic-bezier(0.23,1,0.32,1);}.ds-btn-principal:active{transform:scale(0.97);background:#B8941F;}.ds-btn-principal:focus-visible{outline:2px solid #E2C76B;outline-offset:2px;}"
    },
    {
      "name": "Botón tonal",
      "kind": "button",
      "refersTo": "boton-tonal",
      "description": "Acción secundaria sobre capa tonal (Ver citas, Reprogramar).",
      "html": "<button class=\"ds-btn-tonal\">Ver citas</button>",
      "css": ".ds-btn-tonal{background:#1B2A23;color:#F4F0E8;height:52px;padding:0 20px;border:1px solid #3D4F49;border-radius:14px;font:700 15px Manrope,sans-serif;transition:transform 120ms cubic-bezier(0.23,1,0.32,1);}.ds-btn-tonal:active{transform:scale(0.97);}.ds-btn-tonal:focus-visible{outline:2px solid #D4AF37;}"
    },
    {
      "name": "Botón contorno",
      "kind": "button",
      "refersTo": "boton-contorno",
      "description": "Alternativa directa (Cerrar sesión, No asistió).",
      "html": "<button class=\"ds-btn-contorno\">Cerrar sesión</button>",
      "css": ".ds-btn-contorno{background:transparent;color:#D4AF37;height:52px;padding:0 20px;border:1.2px solid #D4AF37;border-radius:14px;font:700 15px Manrope,sans-serif;}.ds-btn-contorno:active{transform:scale(0.97);}"
    },
    {
      "name": "Campo",
