      "css": ".ds-tarjeta{background:#14211B;border:1px solid #3D4F49;border-radius:18px;padding:16px;display:flex;justify-content:space-between;color:#F4F0E8;font:700 16px Manrope,sans-serif;}.ds-tarjeta span{color:#D4AF37;font-variant-numeric:tabular-nums;}"
